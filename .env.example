# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
# Loaded at startup by run() in src-tauri/src/lib.rs. Real environment
# variables take precedence over anything set here.

# Gemini Live API key -> https://aistudio.google.com/apikey
# Setting this switches live transcription from the local model to
# gemini-3.5-transcribe-live. Unset or leave empty to use the local model.
HANDY_GEMINI_KEY=

# Optional: how Gemini words the transcript.
#   SMART    (default) removes filler words and false starts, applies spoken
#            corrections, and adds punctuation and capital letters.
#   VERBATIM keeps every word as it was spoken.
# HANDY_GEMINI_MODE=SMART

# Optional: names, brands and technical terms that Gemini must spell correctly.
# Separate the terms with commas. The limit is 1,000 terms. Google gets the
# best results with 100 terms or fewer.
# HANDY_GEMINI_VOCABULARY=Tauri, Kubernetes, Mohibur Rahman

# Optional: log verbosity for the Rust backend.
# RUST_LOG=info,handy_app_lib=debug
